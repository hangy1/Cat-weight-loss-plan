[Unit]
Description=Cat Weight Loss FastAPI Application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cat_weightloss
Environment="PATH=/home/ubuntu/cat_weightloss/.venv/bin"
ExecStart=/home/ubuntu/cat_weightloss/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
